{
  "schema_version": "feedback-export-v0.1",
  "adapter_version": "feedback-retraining-adapter-v0.1",
  "merge_version": "feedback-routerbench-v2-merge-v0.2",
  "base_dataset_contract": {
    "dataset_version": "withmartian-routerbench-2024-03-27",
    "label_rule_version": "minimum-sufficient-tier-v2",
    "preprocessing_version": "routerbench-training-preprocess-v2-balanced",
