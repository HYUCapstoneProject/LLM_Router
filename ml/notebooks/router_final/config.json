  "external_split": {
    "train": 0.5,
    "dev": 0.15,
    "test": 0.35
  },
  "split_seed": 20261016,
  "inputs": {
    "a_train": "ml/artifacts/routing-objective-continual-v1/dataset/train.parquet",
    "a_dev": "ml/artifacts/routing-objective-continual-v1/dataset/validation.parquet",
    "a_test_routerbench": "ml/artifacts/frozen-evaluation-outcomes/continual-v1-20260924-28cbc342c510/test_routerbench.parquet",
    "a_test_xroutebench": "ml/artifacts/frozen-evaluation-outcomes/continual-v1-20260924-28cbc342c510/test_xroutebench.parquet",
    "a_candidate_statistics": "ml/artifacts/routing-objective-continual-v1/dataset/candidate-statistics.parquet",
    "llmrouterbench": "ml/artifacts/external-evaluation-v1/llmrouterbench.parquet",
    "sprout": "ml/artifacts/external-evaluation-v1/sprout.parquet",
    "sprout_model_cost": "experiments/results/router-final-inputs/sprout-model-cost-calibration.csv",
    "routerarena": "ml/data/raw/routerarena/full-00000-of-00001.parquet",
