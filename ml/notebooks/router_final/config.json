    "sprout": {
      "input": "sprout",
      "train_slices": [
        "secondary_general_chat",
        "secondary_new_family"
      ],
      "test_only_slices": []
    }
  },
  "routerarena_overlap": {
    "rule": "question body before options, alphanumeric lowercase, first 40 chars; or whole text first 80 chars",
    "body_chars": 40,
    "text_chars": 80
  }
