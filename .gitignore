frontend/.env.*.local

# ── Backend (Spring Boot / Gradle) ───────────────────────────────────
backend/.gradle/
backend/build/
backend/out/
backend/hs_err_pid*.log
backend/replay_pid*.log
backend/.env

# Local Codex Gradle cache
.gradle-codex/

# Local Python/model caches for reranker evaluation
.venv-reranker/
.hf-cache/

# 평가 스크립트 실행 시 생성됨
__pycache__/
*.pyc

# Gradle wrapper (선택: 팀 공유 시 아래 두 줄 주석 처리)
!backend/gradle/
!backend/gradlew
!backend/gradlew.bat
