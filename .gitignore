# ── IDE ──────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker / 로컬 인프라 ──────────────────────────────────────────────
.env

# ── 개인 도구 설정 / JVM 크래시 산출물 ───────────────────────────────
.claude/
hs_err_pid*.log
replay_pid*.log

# ── Frontend (Vite / Node) ───────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.env
